  "cases": [
    {
      "name": "default values of every type",
      "chamber": {
        "rules": {
          "s": {
            "type": "string",
            "value": "hello"
          },
          "n": {
            "type": "number",
            "value": 10.5
          },
          "b": {
            "type": "boolean",
            "value": true
          },
          "c": {
            "type": "custom",
            "value": {
              "a": [
                1,
                2
              ],
              "b": null
            }
          },
          "c-target": {
            "type": "custom",
            "value": {
              "x": 1
            },
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "tenantId",
                    "op": "in",
                    "values": [
                      "acme"
                    ]
                  }
                ],
                "value": [
                  "list",
                  2
                ]
              }
            ]
          }
        }
      },
      "contexts": [
        {
          "context": {},
          "expect": {
            "s": "hello",
            "n": 10.5,
            "b": true,
            "c": {
              "a": [
                1,
                2
              ],
              "b": null
            },
            "c-target": {
              "x": 1
            }
          }
        },
        {
          "context": {
            "attributes": {
              "tenantId": "acme"
            }
          },
          "expect": {
            "s": "hello",
            "n": 10.5,
            "b": true,
            "c": {
              "a": [
                1,
                2
              ],
              "b": null
            },
            "c-target": [
              "list",
              2
            ]
          }
        }
      ]
    },
    {
      "name": "operators, AND, and first match",
      "chamber": {
        "rules": {
          "tenant-in": {
            "type": "string",
            "value": "off",
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "tenantId",
                    "op": "in",
                    "values": [
                      "acme",
                      "globex"
                    ]
                  }
                ],
                "value": "on"
              }
            ]
          },
          "tenant-not-in": {
            "type": "string",
            "value": "off",
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "tenantId",
                    "op": "notIn",
                    "values": [
                      "acme"
                    ]
                  }
                ],
                "value": "on"
              }
            ]
          },
          "sha-prefix": {
            "type": "string",
            "value": "old",
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "buildSha",
                    "op": "startsWith",
                    "values": [
                      "abc123",
                      "def"
                    ]
                  }
                ],
                "value": "new"
              }
            ]
          },
          "and-first-match": {
            "type": "number",
            "value": 0,
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "tenantId",
                    "op": "in",
                    "values": [
                      "acme"
                    ]
                  },
                  {
                    "attribute": "environment",
                    "op": "in",
                    "values": [
                      "prod"
                    ]
                  }
                ],
                "value": 1
              },
              {
                "clauses": [
                  {
                    "attribute": "tenantId",
                    "op": "in",
                    "values": [
                      "acme"
                    ]
                  }
                ],
                "value": 2
              }
            ]
          },
          "by-key": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "key",
                    "op": "in",
                    "values": [
                      "user-1"
                    ]
                  }
                ],
                "value": true
              }
            ]
          },
          "no-clauses": {
            "type": "string",
            "value": "default",
            "targeting": [
              {
                "value": "everyone"
              }
            ]
          }
        }
      },
      "contexts": [
        {
          "context": {
            "key": "user-1",
            "attributes": {
              "tenantId": "acme",
              "environment": "prod",
              "buildSha": "abc1234567"
            }
          },
          "expect": {
            "tenant-in": "on",
            "tenant-not-in": "off",
            "sha-prefix": "new",
            "and-first-match": 1,
            "by-key": true,
            "no-clauses": "everyone"
          }
        },
        {
          "context": {
            "key": "user-2",
            "attributes": {
              "tenantId": "acme",
              "environment": "staging",
              "buildSha": "de"
            }
          },
          "expect": {
            "tenant-in": "on",
            "tenant-not-in": "off",
            "sha-prefix": "old",
            "and-first-match": 2,
            "by-key": false,
            "no-clauses": "everyone"
          }
        },
        {
          "context": {
            "key": "user-3",
            "attributes": {
              "tenantId": "initech"
            }
          },
          "expect": {
            "tenant-in": "off",
            "tenant-not-in": "on",
            "sha-prefix": "old",
            "and-first-match": 0,
            "by-key": false,
            "no-clauses": "everyone"
          }
        },
        {
          "context": {},
          "expect": {
            "tenant-in": "off",
            "tenant-not-in": "off",
            "sha-prefix": "old",
            "and-first-match": 0,
            "by-key": false,
            "no-clauses": "everyone"
          }
        }
      ]
    },
    {
      "name": "process-wide default attributes",
      "defaults": {
        "environment": "prod",
        "version": "2.1.0"
      },
      "chamber": {
        "rules": {
          "prod-only": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "environment",
                    "op": "in",
                    "values": [
                      "prod"
                    ]
                  }
                ],
                "value": true
              }
            ]
          },
          "new-ui": {
            "type": "string",
            "value": "v1",
            "targeting": [
              {
                "clauses": [
                  {
                    "attribute": "version",
                    "op": "semverGte",
                    "values": [
                      "2.0.0"
                    ]
                  }
                ],
                "value": "v2"
              }
            ]
          }
        }
      },
      "contexts": [
        {
          "context": {},
          "expect": {
            "prod-only": true,
            "new-ui": "v2"
          }
        },
        {
          "context": {
            "attributes": {
              "environment": "staging",
              "version": "1.9.0"
            }
          },
          "expect": {
            "prod-only": false,
            "new-ui": "v1"
          }
        }
      ]
    },
    {
      "name": "rollouts",
      "chamber": {
        "rules": {
          "beta": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "value": true,
                "rollout": {
                  "percentage": 50
                }
              }
            ]
          },
          "all": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "value": true,
                "rollout": {
                  "percentage": 100
                }
              }
            ]
          },
          "none": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "value": true,
                "rollout": {
                  "percentage": 0
                }
              }
            ]
          },
          "by-tenant": {
            "type": "boolean",
            "value": false,
            "targeting": [
              {
                "value": true,
                "rollout": {
                  "percentage": 50,
                  "bucketBy": "tenantId",
                  "seed": "shared"
                }
              }
            ]
          },
          "fallthrough": {
            "type": "string",
            "value": "default",
            "targeting": [
              {
                "value": "rolled",
                "rollout": {
                  "percentage": 50,
                  "seed": "beta"
                }
              },
              {
                "value": "next"
              }
            ]
          }
        }
      },
      "contexts": [
        {
          "context": {
            "key": "user-1",
            "attributes": {
              "tenantId": "acme"
            }
          },
          "expect": {
            "beta": true,
            "all": true,
            "none": false,
            "by-tenant": false,
            "fallthrough": "rolled"
          }
        },
        {
          "context": {
            "key": "user-4",
            "attributes": {
              "tenantId": "globex"
            }
          },
          "expect": {
            "beta": false,
            "all": true,
            "none": false,
            "by-tenant": true,
            "fallthrough": "next"
          }
        },
        {
          "context": {
            "key": "user-6"
          },
          "expect": {
            "beta": true,
            "all": true,
            "none": false,
            "by-tenant": false,
            "fallthrough": "rolled"
          }
        },
        {
          "context": {
            "attributes": {
              "tenantId": "globex"
            }
          },
          "expect": {
            "beta": false,
            "all": false,
            "none": false,
            "by-tenant": true,
            "fallthrough": "next"
          }
        }
      ]
    }
  ]
