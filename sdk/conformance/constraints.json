{
  "comment": "Flag constraints cases the Go module (pkg/schema_test.go) and the web UI (http/realm-ui/src/utils/constraints.test.ts) both run. schemas: whether a flag of flagType may have the schema as its constraints. values: whether the schema allows the value and, when it does not, where in the value the first refused part is (path). The server is the authority; the UI checks the same way so that it can explain a value before saving.",
  "schemas": [
    { "name": "empty", "flagType": "number", "schema": {}, "valid": true },
    { "name": "bounds", "flagType": "number", "schema": { "minimum": 1, "maximum": 72 }, "valid": true },
    { "name": "bounds reversed", "flagType": "number", "schema": { "minimum": 72, "maximum": 1 }, "valid": false },
    { "name": "equal bounds", "flagType": "number", "schema": { "minimum": 5, "maximum": 5 }, "valid": true },
    { "name": "integer type on a number flag", "flagType": "number", "schema": { "type": "integer", "minimum": 1 }, "valid": true },
    { "name": "number type on a number flag", "flagType": "number", "schema": { "type": "number" }, "valid": true },
    { "name": "string type on a number flag", "flagType": "number", "schema": { "type": "string" }, "valid": false },
    { "name": "string keyword on a number flag", "flagType": "number", "schema": { "maxLength": 3 }, "valid": false },
    { "name": "object keyword on a number flag", "flagType": "number", "schema": { "required": [] }, "valid": false },
    { "name": "multipleOf", "flagType": "number", "schema": { "multipleOf": 0.5 }, "valid": true },
    { "name": "multipleOf zero", "flagType": "number", "schema": { "multipleOf": 0 }, "valid": false },
    { "name": "multipleOf negative", "flagType": "number", "schema": { "multipleOf": -1 }, "valid": false },
    { "name": "number enum", "flagType": "number", "schema": { "enum": [1, 2, 3] }, "valid": true },
    { "name": "string in a number enum", "flagType": "number", "schema": { "enum": ["1"] }, "valid": false },
    { "name": "enum value out of bounds", "flagType": "number", "schema": { "enum": [24, 100], "maximum": 72 }, "valid": false },
    { "name": "enum value not a multiple", "flagType": "number", "schema": { "enum": [1.5], "multipleOf": 1 }, "valid": false },
    { "name": "empty enum", "flagType": "number", "schema": { "enum": [] }, "valid": false },
    { "name": "enum not an array", "flagType": "number", "schema": { "enum": 1 }, "valid": false },
    { "name": "minimum a string", "flagType": "number", "schema": { "minimum": "1" }, "valid": false },
    { "name": "minimum null", "flagType": "number", "schema": { "minimum": null }, "valid": false },
    { "name": "keywords are case-sensitive", "flagType": "number", "schema": { "Minimum": 1 }, "valid": false },
    { "name": "exclusiveMaximum is not checked", "flagType": "number", "schema": { "exclusiveMaximum": 72 }, "valid": false },
    { "name": "maxLength", "flagType": "string", "schema": { "maxLength": 140 }, "valid": true },
    { "name": "zero lengths", "flagType": "string", "schema": { "minLength": 0, "maxLength": 0 }, "valid": true },
    { "name": "fractional length", "flagType": "string", "schema": { "minLength": 1.5 }, "valid": false },
    { "name": "negative length", "flagType": "string", "schema": { "minLength": -1 }, "valid": false },
    { "name": "lengths reversed", "flagType": "string", "schema": { "minLength": 5, "maxLength": 3 }, "valid": false },
    { "name": "string enum", "flagType": "string", "schema": { "enum": ["standard", "express"] }, "valid": true },
    { "name": "enum value too long", "flagType": "string", "schema": { "enum": ["abcd"], "maxLength": 3 }, "valid": false },
    { "name": "pattern is not checked", "flagType": "string", "schema": { "pattern": "^a" }, "valid": false },
    { "name": "number keyword on a string flag", "flagType": "string", "schema": { "minimum": 1 }, "valid": false },
    { "name": "string type on a string flag", "flagType": "string", "schema": { "type": "string" }, "valid": true },
    { "name": "boolean enum", "flagType": "boolean", "schema": { "enum": [true] }, "valid": true },
    { "name": "number keyword on a boolean flag", "flagType": "boolean", "schema": { "minimum": 1 }, "valid": false },
    { "name": "custom: empty", "flagType": "custom", "schema": {}, "valid": true },
    {
      "name": "custom: object",
      "flagType": "custom",
      "schema": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 140 },
          "qty": { "type": "integer", "minimum": 1 },
          "lines": { "type": "array", "items": { "type": "object", "properties": { "qty": { "minimum": 1 } } } }
        }
      },
      "valid": true
    },
    { "name": "custom: keyword ruled out by type", "flagType": "custom", "schema": { "type": "object", "minimum": 1 }, "valid": false },
    { "name": "custom: keyword of another type, without a type", "flagType": "custom", "schema": { "minimum": 1, "maxLength": 3 }, "valid": true },
    { "name": "custom: integer keyword", "flagType": "custom", "schema": { "type": "integer", "multipleOf": 2 }, "valid": true },
    { "name": "custom: nested unknown keyword", "flagType": "custom", "schema": { "type": "object", "properties": { "a": { "pattern": "x" } } }, "valid": false },
    { "name": "custom: properties not an object", "flagType": "custom", "schema": { "properties": [] }, "valid": false },
    { "name": "custom: property not a schema", "flagType": "custom", "schema": { "properties": { "a": 1 } }, "valid": false },
    { "name": "custom: required twice", "flagType": "custom", "schema": { "required": ["a", "a"] }, "valid": false },
    { "name": "custom: required not strings", "flagType": "custom", "schema": { "required": [1] }, "valid": false },
    { "name": "custom: additionalProperties a schema", "flagType": "custom", "schema": { "additionalProperties": {} }, "valid": false },
    { "name": "custom: required but not allowed", "flagType": "custom", "schema": { "additionalProperties": false, "required": ["a"] }, "valid": false },
    { "name": "custom: required and allowed", "flagType": "custom", "schema": { "additionalProperties": false, "properties": { "a": {} }, "required": ["a"] }, "valid": true },
    { "name": "custom: additionalProperties true", "flagType": "custom", "schema": { "additionalProperties": true }, "valid": true },
    { "name": "custom: items an array", "flagType": "custom", "schema": { "items": [{}] }, "valid": false },
    { "name": "custom: items", "flagType": "custom", "schema": { "items": { "type": "number" } }, "valid": true },
    { "name": "custom: unknown type", "flagType": "custom", "schema": { "type": "tuple" }, "valid": false },
    { "name": "custom: type list", "flagType": "custom", "schema": { "type": ["string", "null"] }, "valid": false },
    { "name": "custom: not an object", "flagType": "custom", "schema": [], "valid": false },
    { "name": "custom: boolean schema", "flagType": "custom", "schema": true, "valid": false },
    { "name": "custom: null", "flagType": "custom", "schema": null, "valid": false },
    { "name": "custom: enum of any values", "flagType": "custom", "schema": { "enum": [{ "a": 1 }, null, [1, 2], "x"] }, "valid": true },
    { "name": "custom: enum value of the wrong type", "flagType": "custom", "schema": { "type": "object", "enum": [{ "a": 1 }, [1]] }, "valid": false },
    { "name": "custom: enum value missing a required property", "flagType": "custom", "schema": { "required": ["b"], "enum": [{ "a": 1 }] }, "valid": false }
  ],
  "values": [
    { "name": "within bounds", "schema": { "minimum": 1, "maximum": 72 }, "value": 24, "valid": true },
    { "name": "at the minimum", "schema": { "minimum": 1, "maximum": 72 }, "value": 1, "valid": true },
    { "name": "at the maximum", "schema": { "minimum": 1, "maximum": 72 }, "value": 72, "valid": true },
    { "name": "below the minimum", "schema": { "minimum": 1, "maximum": 72 }, "value": 0, "valid": false, "path": "" },
    { "name": "above the maximum", "schema": { "minimum": 1, "maximum": 72 }, "value": 7200, "valid": false, "path": "" },
    { "name": "just above the maximum", "schema": { "minimum": 1, "maximum": 72 }, "value": 72.5, "valid": false, "path": "" },
    { "name": "negative bound", "schema": { "minimum": -10 }, "value": -10.5, "valid": false, "path": "" },
    { "name": "whole number", "schema": { "multipleOf": 1 }, "value": 3, "valid": true },
    { "name": "not a whole number", "schema": { "multipleOf": 1 }, "value": 3.5, "valid": false, "path": "" },
    { "name": "multiple of a tenth", "schema": { "multipleOf": 0.1 }, "value": 0.3, "valid": true },
    { "name": "not a multiple of a tenth", "schema": { "multipleOf": 0.1 }, "value": 0.35, "valid": false, "path": "" },
    { "name": "price in cents", "schema": { "multipleOf": 0.01 }, "value": 19.99, "valid": true },
    { "name": "large multiple", "schema": { "multipleOf": 0.25 }, "value": 1000000.75, "valid": true },
    { "name": "zero is a multiple", "schema": { "multipleOf": 7 }, "value": 0, "valid": true },
    { "name": "negative multiple", "schema": { "multipleOf": 7 }, "value": -14, "valid": true },
    { "name": "integer", "schema": { "type": "integer" }, "value": 3, "valid": true },
    { "name": "integer written with a fraction", "schema": { "type": "integer" }, "value": 3.0, "valid": true },
    { "name": "not an integer", "schema": { "type": "integer" }, "value": 3.5, "valid": false, "path": "" },
    { "name": "number enum", "schema": { "enum": [1, 2.5] }, "value": 2.5, "valid": true },
    { "name": "not in a number enum", "schema": { "enum": [1, 2.5] }, "value": 2, "valid": false, "path": "" },
    { "name": "number enum compares numerically", "schema": { "enum": [1.0] }, "value": 1, "valid": true },
    { "name": "at the maximum length", "schema": { "maxLength": 5 }, "value": "hello", "valid": true },
    { "name": "over the maximum length", "schema": { "maxLength": 5 }, "value": "hello!", "valid": false, "path": "" },
    { "name": "length counts code points, not bytes", "schema": { "maxLength": 5 }, "value": "héllo", "valid": true },
    { "name": "length counts code points, not UTF-16 units", "schema": { "maxLength": 5 }, "value": "😀😀😀😀😀", "valid": true },
    { "name": "too many code points", "schema": { "maxLength": 5 }, "value": "😀😀😀😀😀😀", "valid": false, "path": "" },
    { "name": "empty below the minimum length", "schema": { "minLength": 1 }, "value": "", "valid": false, "path": "" },
    { "name": "string enum", "schema": { "enum": ["standard", "express"] }, "value": "express", "valid": true },
    { "name": "string enum is case-sensitive", "schema": { "enum": ["standard", "express"] }, "value": "Express", "valid": false, "path": "" },
    { "name": "boolean enum", "schema": { "enum": [true] }, "value": false, "valid": false, "path": "" },
    { "name": "wrong type", "schema": { "type": "string" }, "value": 1, "valid": false, "path": "" },
    { "name": "null type", "schema": { "type": "null" }, "value": null, "valid": true },
    { "name": "keyword about another type", "schema": { "minimum": 1 }, "value": "x", "valid": true },
    {
      "name": "object",
      "schema": { "type": "object", "required": ["text"], "additionalProperties": false, "properties": { "text": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } } },
      "value": { "text": "hi", "qty": 2 },
      "valid": true
    },
    {
      "name": "object missing a required property",
      "schema": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } },
      "value": { "qty": 2 },
      "valid": false,
      "path": ""
    },
    {
      "name": "object property out of bounds",
      "schema": { "type": "object", "properties": { "text": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } } },
      "value": { "text": "hi", "qty": 0 },
      "valid": false,
      "path": "qty"
    },
    {
      "name": "object with a property not allowed",
      "schema": { "type": "object", "additionalProperties": false, "properties": { "text": { "type": "string" } } },
      "value": { "text": "hi", "extra": 1 },
      "valid": false,
      "path": ""
    },
    {
      "name": "object properties are checked in name order",
      "schema": { "properties": { "a": { "type": "string" }, "b": { "type": "string" } } },
      "value": { "b": 1, "a": 2 },
      "valid": false,
      "path": "a"
    },
    {
      "name": "nested array element",
      "schema": { "properties": { "lines": { "items": { "properties": { "qty": { "minimum": 1 } } } } } },
      "value": { "lines": [{ "qty": 1 }, { "qty": 0 }] },
      "valid": false,
      "path": "lines[1].qty"
    },
    { "name": "array", "schema": { "type": "array", "items": { "type": "number" } }, "value": [1, 2], "valid": true },
    { "name": "array element of the wrong type", "schema": { "type": "array", "items": { "type": "number" } }, "value": [1, "2"], "valid": false, "path": "[1]" },
    { "name": "property name that is not an identifier", "schema": { "properties": { "a.b": { "type": "number" } } }, "value": { "a.b": "x" }, "valid": false, "path": "[\"a.b\"]" },
    { "name": "property name starting with a digit", "schema": { "properties": { "1st": { "type": "number" } } }, "value": { "1st": "x" }, "valid": false, "path": "[\"1st\"]" },
    { "name": "object enum ignores member order", "schema": { "enum": [{ "a": 1, "b": 2 }] }, "value": { "b": 2, "a": 1 }, "valid": true },
    { "name": "array enum keeps element order", "schema": { "enum": [[2, 1]] }, "value": [1, 2], "valid": false, "path": "" },
    { "name": "nested enum compares numerically", "schema": { "enum": [{ "n": 1.0 }] }, "value": { "n": 1 }, "valid": true }
  ]
}
